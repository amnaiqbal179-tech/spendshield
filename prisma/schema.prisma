generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  industry           String?
  employeeCount      Int?
  currency           String               @default("USD")
  timezone           String               @default("UTC")
  logoUrl            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  clerkOrgId         String?              @unique

  Approval           Approval[]
  AuditLog           AuditLog[]
  Decision           Decision[]
  departments        Department[]
  Membership         Membership[]
  Notification       Notification[]
  Renewal            Renewal[]
  SavingsOpportunity SavingsOpportunity[]
  SavingsRecord      SavingsRecord[]
  subscriptions      Subscription[]
  VendorNegotiation  VendorNegotiation[]
  RenewalNote        RenewalNote[]
  monthlyForecasts   MonthlyForecast[]
  Request            SoftwareRequest[]

  @@index([name])
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String               @unique
  passwordHash       String?
  image              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  clerkUserId        String?              @unique

  Approval           Approval[]
  AuditLog           AuditLog[]
  Decision           Decision[]
  Department         Department[]
  Membership         Membership[]
  Notification       Notification[]
  SavingsRecord      SavingsRecord[]
  Subscription       Subscription[]
  VendorNegotiation  VendorNegotiation[]
  RenewalNote        RenewalNote[]

  submittedRequests  SoftwareRequest[]    @relation("RequestSubmitter")
  reviewedRequests   SoftwareRequest[]    @relation("RequestReviewer")

  @@index([email])
}

model Department {
  id             String            @id @default(cuid())
  organizationId String
  managerId      String?
  name           String
  description    String?
  monthlyBudget  Decimal           @default(1000.00) @db.Decimal(12, 2) // <-- Yahan budget field add kar di gayi hai
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  User           User?             @relation(fields: [managerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  requests       SoftwareRequest[]

  @@unique([organizationId, name])
  @@index([managerId])
  @@index([organizationId])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  departmentId       String?
  ownerId            String?
  vendor             String
  productName        String
  category           String?
  plan               String?
  billingCycle       BillingCycle
  licenseCount       Int                @default(0)
  activeUsers        Int                @default(0)
  monthlyCost        Decimal            @db.Decimal(12, 2)
  annualCost         Decimal            @db.Decimal(12, 2)
  previousAnnualCost Decimal?           @db.Decimal(12, 2)
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  renewalDate        DateTime
  noticeDeadline     DateTime?
  noticePeriodDays   Int?
  vendorContactEmail String?
  vendorContactName  String?
  autoRenew          Boolean            @default(false)
  criticality        Criticality        @default(MEDIUM)
  paymentMethodLabel String?
  externalId         String?
  status             SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  renewals           Renewal[]
  department         Department?        @relation(fields: [departmentId], references: [id])
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User               User?              @relation(fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([renewalDate])
  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
}

model Renewal {
  id                   String               @id @default(cuid())
  organizationId       String
  subscriptionId       String
  renewalDate          DateTime
  noticeDeadline       DateTime?
  previousCost         Decimal              @db.Decimal(12, 2)
  currentCost          Decimal              @db.Decimal(12, 2)
  priceIncreasePercent Decimal?             @db.Decimal(5, 2)
  readinessScore       Int?
  status               RenewalStatus        @default(UPCOMING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  Decision             Decision?
  Organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription         Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  opportunities        SavingsOpportunity[]
  SavingsRecord        SavingsRecord[]
  VendorNegotiation    VendorNegotiation[]
  RenewalNote          RenewalNote[]

  @@unique([subscriptionId])
  @@index([organizationId])
  @@index([renewalDate])
  @@index([status])
}

model MonthlyForecast {
  id             String       @id @default(cuid())
  organizationId String
  month          String
  spend          Decimal      @db.Decimal(12, 2)
  savings        Decimal      @db.Decimal(12, 2)
  width          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, month])
  @@index([organizationId])
}

model VendorNegotiation {
  id               String           @id @default(cuid())
  organizationId   String
  renewalId        String
  initiatedById    String
  stage            NegotiationStage @default(PREPARING)
  targetPrice      Decimal          @db.Decimal(12, 2)
  maxAcceptable    Decimal?         @db.Decimal(12, 2)
  finalAgreedPrice Decimal?         @db.Decimal(12, 2)
  counterOffer     Decimal?         @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  Organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Renewal          Renewal          @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  InitiatedBy      User             @relation(fields: [initiatedById], references: [id])

  @@index([organizationId])
  @@index([renewalId])
}

model RenewalNote {
  id             String       @id @default(cuid())
  organizationId String
  renewalId      String
  authorId       String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Renewal        Renewal      @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  Author         User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([renewalId])
}

model SavingsOpportunity {
  id                String            @id @default(cuid())
  organizationId    String
  renewalId         String
  type              OpportunityType
  title             String
  description       String?
  estimatedSaving   Decimal           @db.Decimal(12, 2)
  confidence        Int?
  recommendedAction DecisionAction
  status            OpportunityStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  Organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  renewal           Renewal           @relation(fields: [renewalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([renewalId])
  @@index([status])
  @@index([type])
}

model SavingsRecord {
  id              String       @id @default(cuid())
  organizationId  String
  decisionId      String
  renewalId       String
  baselineCost    Decimal      @db.Decimal(12, 2)
  finalCost       Decimal?     @db.Decimal(12, 2)
  potentialSaving Decimal      @db.Decimal(12, 2)
  realizedSaving  Decimal?     @db.Decimal(12, 2)
  savingType      String
  stage           SavingsStage @default(POTENTIAL)
  evidenceNote    String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  decision        Decision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  Organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Renewal         Renewal      @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  User            User?        @relation(fields: [verifiedById], references: [id])

  @@index([decisionId])
  @@index([organizationId])
  @@index([renewalId])
  @@index([stage])
}

model Approval {
  id             String         @id @default(cuid())
  organizationId String
  decisionId     String
  approverId     String
  status         ApprovalStatus @default(PENDING)
  comment        String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  User           User           @relation(fields: [approverId], references: [id], onDelete: Cascade)
  Decision       Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  Organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([approverId])
  @@index([decisionId])
  @@index([organizationId])
  @@index([status])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  reason         String?
  createdAt      DateTime     @default(now())

  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User?        @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([userId])
}

model Decision {
  id                  String             @id @default(cuid())
  organizationId      String
  renewalId           String             @unique
  recommendedAction   DecisionAction
  selectedAction      DecisionAction?
  recommendationScore Decimal?           @db.Decimal(5, 2)
  reasoning           String?
  currentAnnualCost   Decimal            @db.Decimal(12, 2)
  expectedAnnualCost  Decimal?           @db.Decimal(12, 2)
  estimatedSaving     Decimal?           @db.Decimal(12, 2)
  status              DecisionStatus     @default(DRAFT)
  finalizedAt         DateTime?
  finalizedById       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  Approval            Approval[]
  User                User?              @relation(fields: [finalizedById], references: [id])
  Organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Renewal             Renewal            @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  DecisionScenario    DecisionScenario[]
  savingsRecords      SavingsRecord[]

  @@index([organizationId])
  @@index([status])
}

model DecisionScenario {
  id              String         @id @default(cuid())
  decisionId      String
  action          DecisionAction
  licenseCount    Int?
  plan            String?
  discountPercent Decimal?       @db.Decimal(5, 2)
  annualCost      Decimal        @db.Decimal(12, 2)
  estimatedSaving Decimal        @db.Decimal(12, 2)
  businessRisk    String?
  notes           String?
  createdAt       DateTime       @default(now())

  Decision        Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([decisionId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now())

  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Notification {
  id               String           @id @default(cuid())
  organizationId   String
  userId           String
  type             NotificationType
  title            String
  message          String
  relatedRenewalId String?
  relatedRequestId String?
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now())

  Organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([read])
  @@index([type])
  @@index([userId])
}

model SoftwareRequest {
  id              String        @id @default(cuid())
  organizationId  String
  requesterId     String
  departmentId    String?

  softwareName    String
  reason          String
  estimatedCost   Decimal       @db.Decimal(12, 2)

  status          RequestStatus @default(PENDING)

  reviewedById    String?
  reviewComment   String?
  rejectionReason String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewedAt      DateTime?

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester       User          @relation("RequestSubmitter", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("RequestReviewer", fields: [reviewedById], references: [id])
  department      Department?   @relation(fields: [departmentId], references: [id])

  @@index([organizationId])
  @@index([requesterId])
  @@index([departmentId])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
}

enum DecisionAction {
  RENEW
  REDUCE
  DOWNGRADE
  NEGOTIATE
  CANCEL
  REPLACE
}

enum SavingsStage {
  POTENTIAL
  VALIDATED
  APPROVED
  IMPLEMENTED
  REALIZED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

enum DecisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IMPLEMENTED
  COMPLETED
}

enum NegotiationStage {
  PREPARING
  SENT
  VENDOR_RESPONSE
  COUNTER_OFFER
  AGREED
}

enum NotificationType {
  RENEWAL_90_DAYS
  RENEWAL_60_DAYS
  RENEWAL_30_DAYS
  RENEWAL_15_DAYS
  RENEWAL_7_DAYS
  APPROVAL_REQUIRED
  DECISION_REQUIRED
  DEADLINE_WARNING
  SAVINGS_VERIFICATION
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
}

enum OpportunityStatus {
  OPEN
  VALIDATED
  DISMISSED
  CONVERTED
}

enum OpportunityType {
  UNUSED_LICENSES
  UNDERUTILIZATION
  PRICE_INCREASE
  DOWNGRADE
  NEGOTIATION
  CANCELLATION
  DUPLICATE_TOOL
}

enum RenewalStatus {
  UPCOMING
  IN_REVIEW
  DECISION_PENDING
  APPROVAL_PENDING
  APPROVED
  IMPLEMENTED
  COMPLETED
  CANCELLED
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  FINANCE
  IT
  PROCUREMENT
  DEPARTMENT_OWNER
  VIEWER
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}